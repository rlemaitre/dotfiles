{{ if eq .machine "nabla-mac-raphael" -}}
SecurityKeyProvider {{ .chezmoi.homeDir }}/.ssh/libsk-libfido2.dylib

Include {{ .chezmoi.homeDir }}/.config/colima/ssh_config

# OrbStack 'orb' SSH host for Linux machines. Must stay above every Host block.
Include ~/.orbstack/ssh/config

{{ end -}}
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
{{- if .ssh_key }}
  IdentityFile ~/.ssh/{{ .ssh_key }}
{{- end }}
