{{ if eq .machine "nabla-mac-raphael" -}}
SecurityKeyProvider {{ .chezmoi.homeDir }}/.ssh/libsk-libfido2.dylib

{{ end -}}
# 'colima' SSH host, written by Colima. Must stay above every Host block.
Include {{ .chezmoi.homeDir }}/.config/colima/ssh_config

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
{{- if .ssh_key }}
  IdentityFile ~/.ssh/{{ .ssh_key }}
{{- end }}
