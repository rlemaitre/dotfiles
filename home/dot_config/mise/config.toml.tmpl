{{- /* Rendered from packages.yaml. Entries are `name` (latest) or `name@version`.
       Do not apply on a machine before phase 4 of the migration:
       it replaces the live ~/.config/mise/config.toml. */ -}}
{{- $m := .machine -}}
{{- $tools := concat .packages.mise.common (index .packages.mise $m | default (list)) -}}
{{- $excludes := .mise_trust_policy_excludes | default dict -}}
[settings]
experimental = true
idiomatic_version_file_enable_tools = ["node"]
{{- if eq $m "nabla-mac-raphael" }}

[settings.status]
missing_tools = "if_other_versions_installed"
show_env = false
show_tools = false
truncate = false
{{- end }}

[tools]
{{ range $tools | sortAlpha -}}
{{- /* a trailing @version has no "/" or ":" after the "@" (scoped npm names do) */ -}}
{{- $version := regexFind "@[^@/:]+$" . -}}
{{- $name := trimSuffix $version . -}}
{{- $pin := ternary (trimPrefix "@" $version) "latest" (ne $version "") -}}
{{- $value := $pin | quote -}}
{{- if hasKey $excludes $name -}}
{{- $value = printf "{ version = %s, trust_policy_excludes = %s }" ($pin | quote) (index $excludes $name | toJson) -}}
{{- end }}
{{ $name | quote }} = {{ $value }}
{{ end -}}
