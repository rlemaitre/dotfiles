#GPG
export GPG_TTY="$(tty)"
{{ if ne .machine "nabla-mac-raphael" -}}
# gpg-agent serves the SSH keys (the work Mac uses the macOS agent and Keychain instead)
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)
{{ end -}}
gpgconf --launch gpg-agent

# EDITOR
export EDITOR=nvim
export VISUAL=nvim

# man pages through bat, so they use the bat theme
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# PATH
export PATH="$(brew --prefix)/bin:$HOME/.local/bin:/Applications/Xcode.app/Contents/Developer/usr/bin:$PATH"

# Docker runs in Colima. Tools that ignore docker contexts (Testcontainers, some IDEs) need the socket.
export DOCKER_HOST="unix://${XDG_CONFIG_HOME:-$HOME/.config}/colima/default/docker.sock"

# Puppeteer (used by mermaid-cli's mmdc) drives the Chrome cask: mise skips the postinstall that would download
# Puppeteer's own chrome-headless-shell.
export PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

{{ if eq .machine "athena" -}}
# Proton Drive directory
export PROTON_DRIVE_DIR="$HOME/Library/CloudStorage/ProtonDrive-raphael@rlemaitre.com-folder"
{{- end }}

# Homebrew
export HOMEBREW_NO_ENV_HINTS=1
