[alias]
	bb = "!better-branch"
	bc = "!better-commits"
{{- if eq .machine "nabla-mac-raphael" }}
	ds = diff --staged
	lg = log --graph --decorate --oneline --all
	st = status
	ignorechanges = update-index --skip-worktree --
	unignorechanges = update-index --no-skip-worktree --
{{- end }}

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[commit]
	gpgSign = false
	verbose = true

[core]
	fsmonitor = true
	pager = "delta"
	untrackedCache = true
{{- if .ssh_key }}
	sshCommand = "ssh -i ~/.ssh/{{ .ssh_key }}"
{{- end }}
{{- if eq .machine "nabla-mac-raphael" }}
	autocrlf = input
{{- end }}

[github]
	user = "rlemaitre"

[user]
	email = {{ .email | quote }}
	name = "Raphaël Lemaitre"
{{- if .gpg_key }}
	signingKey = {{ .gpg_key | quote }}
{{- end }}

[credential]
	helper = "cache"

[credential "https://gist.github.com"]
	helper = "gh auth git-credential"

[credential "https://github.com"]
	helper = "gh auth git-credential"

[include]
	path = ~/.config/delta/catppuccin.gitconfig

[delta]
	line-numbers = true
	navigate = true
	side-by-side = true

[diff]
{{- if eq .machine "nabla-mac-raphael" }}
	algorithm = "patience"
	colorMoved = "zebra"
	compactionHeuristic = true
{{- else }}
	algorithm = "histogram"
	colorMoved = "plain"
{{- end }}
	mnemonicPrefix = true
	renames = true

[fetch]
	all = true
	prune = true
	pruneTags = {{ if eq .machine "nabla-mac-raphael" }}false{{ else }}true{{ end }}

[format]
	pretty = "oneline"
{{- if eq .machine "nabla-mac-raphael" }}

[log]
	date = "short"

[status]
	short = true
	branch = true
{{- end }}

[gpg]
	format = "openpgp"

[gpg "openpgp"]
	program = "gpg"

[help]
	autocorrect = "prompt"

[init]
	defaultBranch = "main"

[interactive]
	diffFilter = "delta --color-only"

[maintenance]
{{- if eq .machine "nabla-mac-raphael" }}
	repo = {{ joinPath .chezmoi.homeDir "Developer/projects/nabla/health" | quote }}

[maintenance "prefetch"]
	schedule = "hourly"

[maintenance "gc"]
	schedule = "daily"
{{- end }}

[merge]
	conflictstyle = "zdiff3"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = {{ if eq .machine "nabla-mac-raphael" }}"simple"{{ else }}"upstream"{{ end }}
	followTags = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[rerere]
	autoupdate = true
	enabled = true

[tag]
	gpgSign = {{ if .gpg_key }}true{{ else }}false{{ end }}
	sort = "version:refname"
{{- if eq .machine "nabla-mac-raphael" }}

[clean]
	requireForce = true
{{- end }}
