#! /usr/bin/env zsh
#--------------------------------------------------------------#
##          Environment Variables                             ##
#--------------------------------------------------------------#
export XDG_DATA_HOME=${HOME}/.local/share
export XDG_CONFIG_HOME=${HOME}/.config
export XDG_STATE_HOME=${HOME}/.local/state
export XDG_CACHE_HOME=${HOME}/.cache
export XDG_RUNTIME_DIR=${HOME}/Library/Caches/TemporaryItems
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:=$HOME/.config}"

export ZDOTDIR=${HOME}/.config/zsh
export ZHOMEDIR=${HOME}/.config/zsh
export ZRCDIR=${ZHOMEDIR}/rc
export ZDATADIR=${XDG_DATA_HOME}/zsh
export ZCACHEDIR=${XDG_CACHE_HOME}/zsh

# mise shims, for shells that never read .zshrc (where `mise activate` runs): agents, hooks, commands Rex or an app
# starts. Interactive shells put the activated tool paths ahead of these.
export PATH="${XDG_DATA_HOME}/mise/shims:${PATH}"

# Puppeteer (used by mermaid-cli's mmdc) drives the Chrome cask: mise skips the postinstall that would download
# Puppeteer's own chrome-headless-shell. Here, not in env.zsh: Claude Code's shell reads .zshenv but not .zshrc.
export PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# OpenSpec (driven by the kaizen plugin) sends anonymous usage stats unless told not to. Here so Claude Code's shell
# sees it too.
export OPENSPEC_TELEMETRY=0

# Claude Code only draws inline images in terminals it knows by name (kitty, ghostty). Rex supports the kitty
# Unicode placeholders it needs, but is not on that list yet. Not inside tmux or screen, where forced images show as
# empty boxes.
if [[ $TERM_PROGRAM == rex && -z $TMUX && -z $STY ]]; then
  export CLAUDE_CODE_FORCE_TERMINAL_IMAGES=1
fi
