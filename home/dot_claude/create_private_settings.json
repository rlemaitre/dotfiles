{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5-5",
    "SG_AGENTIC_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "sandbox": {
    "excludedCommands": [
      "md-show *",
      "terminal-browser *",
      "ws-issue *",
      "ws-pr-review *",
      "ws-resume *",
      "pr-flow-config"
    ]
  },
  "permissions": {
    "deny": [
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/protect-tasks-md.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "productivity@rlemaitre": true,
    "security-guidance@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "frontend-design@claude-plugins-official": true,
    "taste-skill@taste-skill": true,
    "playwright@claude-plugins-official": true,
    "slidev@slidev-dev-marketplace": true,
    "kitty-image@rlemaitre": true,
    "md-show@rlemaitre": true,
    "terminal-browser@terminal-browser": true,
    "intellij@rlemaitre": true,
    "worktree-sessions@rlemaitre": true,
    "pr-flow@rlemaitre": true,
    "mempalace@mempalace": true,
    "kaizen@rlemaitre": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "rlemaitre": {
      "source": {
        "source": "github",
        "repo": "rlemaitre/claude-plugins"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    },
    "slidev-dev-marketplace": {
      "source": {
        "source": "github",
        "repo": "rhuss/cc-slidev"
      }
    },
    "terminal-browser": {
      "source": {
        "source": "github",
        "repo": "zenbu-labs/terminal-browser"
      }
    },
    "mempalace": {
      "source": {
        "source": "github",
        "repo": "MemPalace/mempalace"
      }
    }
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "tui": "fullscreen"
}
