#!/usr/bin/env bash
{{- /* Re-runs when the tool list for this machine changes. */ -}}
{{- $m := .machine }}
{{- $tools := concat .packages.mise.common (index .packages.mise $m | default (list)) }}
# mise tools: {{ $tools | sortAlpha | join " " }}
#
# zsh completions for tools installed by mise (Homebrew used to link them; mise does not).
# They go to ~/.local/share/zsh/site-functions, which .zshrc puts on fpath before compinit.
# Tools without a completion generator (eza, lazydocker, oh-my-posh) are skipped.
set -uo pipefail

dest="${XDG_DATA_HOME:-${HOME}/.local/share}/zsh/site-functions"
mkdir -p "${dest}"
tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

# gen <name> <command...>: install _<name> from the command's output when it is a zsh completion
gen() {
  local name="$1"
  shift
  command -v "$1" >/dev/null 2>&1 || return 0
  if "$@" >"${tmp}/_${name}" 2>/dev/null && head -n 1 "${tmp}/_${name}" | grep -q '^#compdef'; then
    mv "${tmp}/_${name}" "${dest}/_${name}"
  else
    echo "no zsh completion generated for ${name}" >&2
  fi
}

# copy_shipped <command> <path inside the release tarball> <name>
copy_shipped() {
  local bin dir
  bin="$(mise which "$1" 2>/dev/null)" || return 0
  dir="$(dirname "${bin}")"
  [[ -f "${dir}/$2" ]] && cp "${dir}/$2" "${dest}/_$3" || echo "no shipped completion for $1" >&2
}

gen gh gh completion -s zsh
gen docker docker completion zsh
gen colima colima completion zsh
gen limactl limactl completion zsh
gen just just --completions zsh
gen rg rg --generate complete-zsh
gen glow glow completion zsh
gen chezmoi chezmoi completion zsh
gen yq yq shell-completion zsh
gen gum gum completion zsh
gen delta delta --generate-completion zsh
gen uv uv generate-shell-completion zsh
gen lazygit lazygit completion zsh
gen deno deno completions zsh
gen pnpm pnpm completion zsh
gen op op completion zsh

if command -v atuin >/dev/null 2>&1 && atuin gen-completions --shell zsh --out-dir "${tmp}" >/dev/null 2>&1; then
  mv "${tmp}/_atuin" "${dest}/_atuin"
fi

copy_shipped fd autocomplete/_fd fd
copy_shipped bat autocomplete/bat.zsh bat
